rules_version = '2';

// Craft rules based on data in your Firestore database
// allow write: if firestore.get(
//    /databases/(default)/documents/users/$(request.auth.uid)).data.isAdmin;
service firebase.storage {
  match /b/{bucket}/o {
    // Allow users to upload their own avatar
    match /avatars/{userId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null &&
      request.auth.uid == userId;
    }

    // Allow group chat avatars - only allow users in the chat to read/write
    match /avatars/groupChats/{chatId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow users to upload images for messages - only allow users in the chat to read/write
    match /messages/{chatId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Allow users to upload images for saved messages - only allow the owner to read/write
    match /savedMessages/{userId}/{filename} {
      allow read: if request.auth != null &&
      request.auth.uid == userId;
      allow write: if request.auth != null &&
      request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}