rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Email verification codes - users can only access their own
    match /email_verification_codes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Mail collection - only backend can write, no client access needed
    match /mail/{mailId} {
      allow read, write: if false;
    }

    // User profiles - all users can read, only self can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Friends subcollection
      match /friends/{friendId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && (request.auth.uid == userId ||
        request.auth.uid == request.resource.data.id);
        allow delete: if request.auth != null && (request.auth.uid == userId ||
        request.auth.uid == resource.data.id);
        allow update: if false;
      }

      // Friend incoming requests subcollection
      match /friendIncomingRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.id;
        allow delete: if request.auth != null && (request.auth.uid == userId ||
        request.auth.uid == resource.data.id);
        allow update: if false;
      }

      // Friend outgoing requests subcollection
      match /friendOutgoingRequests/{requestId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && (request.auth.uid == userId ||
        request.auth.uid == resource.data.id);
        allow update: if false;
      }

      // Saved messages subcollection
      match /savedMessages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // Direct chats - users can only read chats they are part of
    match /directChats/{chatId} {
      allow read: if request.auth != null &&
      request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
      request.auth.uid in request.resource.data.participants &&
      request.resource.data.participants.size() == 2;
      allow update, delete: if request.auth != null &&
      request.auth.uid in resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow create: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow delete: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants;
        allow update: if false;
      }
    }

    // Group chats - users can only read chats they are part of
    match /groupChats/{chatId} {
      allow read: if request.auth != null &&
      request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
      request.auth.uid in request.resource.data.participants &&
      request.resource.data.participants.size() > 2 &&
      request.resource.data.ownerId != null &&
      request.auth.uid == request.resource.data.ownerId;
      allow update: if request.auth != null &&
      request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null &&
      request.auth.uid in resource.data.participants &&
      resource.data.ownerId != null &&
      request.auth.uid == resource.data.ownerId;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/groupChats/$(chatId)).data.participants;
        allow create: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/groupChats/$(chatId)).data.participants;
        allow delete: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/groupChats/$(chatId)).data.participants &&
        (request.auth.uid == get(/databases/$(database)/documents/groupChats/$(chatId)).data.ownerId ||
        request.auth.uid == resource.data.senderId);
        allow update: if false;
      }
    }

    // Projects - users can only read projects they are part of
    match /projects/{projectId} {
      allow read: if request.auth != null &&
      request.auth.uid in resource.data.participants;
      allow create: if request.auth != null &&
      request.auth.uid in request.resource.data.participants &&
      request.resource.data.ownerId != null &&
      request.auth.uid == request.resource.data.ownerId &&
      request.resource.data.participants.size() > 0;
      allow update, delete: if request.auth != null &&
      request.auth.uid in resource.data.participants &&
      resource.data.ownerId != null &&
      request.auth.uid == resource.data.ownerId;

      // Feedback subcollection
      match /feedback/{feedbackId} {
        allow read: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.participants;
        allow create: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.participants &&
        request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.participants &&
        request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
